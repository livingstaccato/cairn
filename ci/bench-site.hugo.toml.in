baseURL = "/"
title = "bench"

# Both modules are imported by path, exactly as a consumer would, and resolved
# locally by the replace lines in go.mod. Importing rather than mounting is the
# point: it exercises the real module identity the repo publishes.
[module]
  [[module.imports]]
    path = "github.com/livingstaccato/cairndex"
  [[module.imports]]
    path = "github.com/livingstaccato/cairndex/themes/reference"


# index.json and index.csv beside index.html, from one source.
[outputFormats]
  [outputFormats.cairndexjson]
    mediaType = "application/json"
    baseName = "index"
    isPlainText = true
    notAlternative = true
  [outputFormats.cairndexcsv]
    mediaType = "text/csv"
    baseName = "index"
    isPlainText = true
    notAlternative = true

[outputs]
  home = ["html", "cairndexjson", "cairndexcsv"]
  section = ["html", "cairndexjson", "cairndexcsv"]

[mediaTypes]
  [mediaTypes."text/csv"]
    suffixes = ["csv"]
