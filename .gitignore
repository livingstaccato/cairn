# Build output
/cairn
coverage.out
coverage.html

# Generated by the example site
/exampleSite/content/
/exampleSite/public/
/exampleSite/resources/
/testdata/example/out/

# Per-run state written into the output tree
.cairn-cache.json
.cairn-manifest.json

# Tooling
node_modules/
.DS_Store

# CLAUDE.md is a symlink to AGENTS.md, created locally so Claude Code picks up
# the same instructions. AGENTS.md is the tracked source of truth.
/CLAUDE.md

# Hugo build state
/exampleSite/public/
/exampleSite/content/
/exampleSite/resources/
.hugo_build.lock

# act artifacts
/.act-actions/

# The example tree is a fixture, and a global gitignore excluding *.deb, *.rpm
# and archive extensions is normal on a developer's machine — which silently
# kept the package pool out of the repo entirely. CI then ran the end-to-end
# example against an empty pool, so the bare presenter over a package
# repository was proved against nothing. A repository .gitignore takes
# precedence over core.excludesFile, so these negations put the fixtures back.
!/exampleSite/tree/**
!/testdata/**
